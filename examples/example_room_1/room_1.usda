def Xform "materials"
{
    # light woven/fabric surface; diffuse reflectivity proxy = 0.65
    def Material "mattress_fabric"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.65
    }

    # matte white painted wall; clearly brighter than the floor but below the ceiling
    def Material "white_painted_wall"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.75
    }

    # ground finish: intentionally much darker than the wall so it stays visually separate in the reflective map
    def Material "ground_material"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.20
    }

    # finished light/medium wood; diffuse reflectivity proxy = 0.55
    def Material "bed_frame_wood"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.55
    }

    # finished wood door; diffuse reflectivity proxy = 0.50
    def Material "wood_door"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.50
    }

    # finished wood tabletop/frame; darker than the ground for clear contrast in the reflective map
    def Material "wood_table"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.10
    }

    # finished medium wood; diffuse reflectivity proxy = 0.45
    def Material "wood_drawer"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.45
    }

    # dark display glass / bezel; diffuse reflectivity proxy = 0.20
    def Material "dark_screen"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.20
    }

    # dark speaker grille/plastic; diffuse reflectivity proxy = 0.25
    def Material "speaker_dark"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.25
    }

    # dark keyboard plastic/keycaps; diffuse reflectivity proxy = 0.25
    def Material "keyboard_dark"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.25
    }

    # painted/finished hanger structure; diffuse reflectivity proxy = 0.45
    def Material "hanger_material"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.45
    }

    # matte white painted ceiling; highest reflectivity so it stays distinct from the wall and the ground
    def Material "white_ceiling"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.95
    }

    # fabric/plastic chair surface; diffuse reflectivity proxy = 0.40
    def Material "chair_material"
    {
        token inputs:materialType = "lambert"
        float inputs:reflectivity = 0.40
    }
}
