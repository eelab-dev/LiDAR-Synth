    {"command": "histogram", "options": {"input_pixelized_file": "{output_dir}/photons.h5", "min_range": 0, "bin_width": 100, "bin_number": 64, "emission_mean": 2300, "output_histogram_file": "{output_dir}/histogram.h5"}}
